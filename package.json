{
  "name": "lceda-batch-export",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "嘉立创 EDA 专业版多子板生产与测试文件批量导出",
  "scripts": {
    "build": "npm run locales && node scripts/build.mjs",
